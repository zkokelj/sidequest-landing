VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-public-key...
# Empty = same-origin (vite proxies /api during dev). Set to API URL in production.
VITE_API_BASE=
# Paywall toggle — "true" routes onboarding through /paywall (Polar checkout).
# Anything else (or unset) skips straight to /paywall/thanks for demo / sign-up flow.
VITE_PAYWALL_ENABLED=false
